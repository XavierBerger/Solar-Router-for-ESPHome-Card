    "@rollup/plugin-typescript": "^12.1.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rollup": "^4.29.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
